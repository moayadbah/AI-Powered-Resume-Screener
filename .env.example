# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env

# ------------------------------------------------------------------
# MongoDB
# ------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=screener
MONGO_INITDB_ROOT_PASSWORD=change-me-locally
MONGO_DATABASE=screener
# Used by api-service. Host is the compose service name, not localhost.
MONGODB_URI=mongodb://screener:change-me-locally@mongodb:27017/screener?authSource=admin

# ------------------------------------------------------------------
# api-service (Java / Spring Boot) — port 8080
# ------------------------------------------------------------------
# HS256 signing key. Must be >= 32 chars. The app refuses to start if this is
# left at the placeholder value below. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-a-real-32-char-minimum-secret
JWT_EXPIRY_HOURS=24
AI_SERVICE_BASE_URL=http://ai-service:8000
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=5
MAX_FILES_PER_REQUEST=10
MAX_RESUMES_PER_SCREEN=50
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------
# ai-service (Python / FastAPI) — port 8000
# ------------------------------------------------------------------
# Shared secret sent by api-service as the X-Service-Token header.
# Same value must be set on both services.
SERVICE_TOKEN=replace-me-with-a-shared-internal-token
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
SEMANTIC_WEIGHT=0.7
SKILL_WEIGHT=0.3
# Ollama runs on the HOST, not in compose. From inside a container use
# host.docker.internal; running ai-service natively, use localhost.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60
SUMMARY_ENABLED=true

# ------------------------------------------------------------------
# web (React / Vite) — port 5173
# ------------------------------------------------------------------
# Vite only exposes vars prefixed with VITE_ to the browser.
# Never put a secret here — it ends up in the bundle.
VITE_API_BASE_URL=http://localhost:8080
