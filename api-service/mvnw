#!/bin/sh
set -eu
MVNW_VERSION=3.9.9
MVNW_DIR="${HOME}/.m2/wrapper/dists/apache-maven-${MVNW_VERSION}"
MVNW_BIN="${MVNW_DIR}/apache-maven-${MVNW_VERSION}/bin/mvn"
if [ ! -x "$MVNW_BIN" ]; then
  mkdir -p "$MVNW_DIR"
  ARCHIVE="$MVNW_DIR/maven.zip"
  URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MVNW_VERSION}/apache-maven-${MVNW_VERSION}-bin.zip"
  if command -v curl >/dev/null 2>&1; then curl -fsSL "$URL" -o "$ARCHIVE"; else wget -q "$URL" -O "$ARCHIVE"; fi
  unzip -q "$ARCHIVE" -d "$MVNW_DIR"
  rm "$ARCHIVE"
fi
exec "$MVNW_BIN" "$@"
